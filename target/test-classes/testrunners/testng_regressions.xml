<?xml version="1.0" encoding="UTF-8"?>
<suite name="Open Cart Test Regression PW Suite" thread-count='4'
	parallel='tests' verbose='4'>

	<listeners>
		<listener
			class-name="com.qa.opencart.listeners.ExtentReportListener" />
	</listeners>

	<test name="Open Cart Home Page Test">
		<parameter name='browser' value='chrome' />
		<classes>
			<class name="com.qa.opencart.tests.HomePageTest" />
		</classes>
	</test>

	<test name="Open Cart Login Page Test On Chromium">
		<parameter name='browser' value='chromium' />
		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>

	<test name="Open Cart Login Page Test On Firefox">
		<parameter name='browser' value='firefox' />
		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>
	
	<test name="Open Cart Login Page Test On Edge">
		<parameter name='browser' value='edge' />
		<classes>
			<class name="com.qa.opencart.tests.LoginPageTest" />
		</classes>
	</test>

</suite>